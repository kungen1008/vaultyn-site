---
// 功能页：顶部目录 + 一节一节的图文介绍 + “还有这些”
import Base from '../layouts/Base.astro';
import { FEATURES } from '../features';
import { shots, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const f = FEATURES[lang]!, img = shots(lang);
---
<Base lang={lang} page="features/" title={f.title}>
  <header class="fh"><div class="wrap">
    <h1>{f.title}</h1><p class="lead">{f.lead}</p>
    <nav class="toc">{f.sections.map(s => <a href={`#${s.id}`}>{s.kicker}</a>)}</nav>
  </div></header>
  <main class="wrap">
    {f.sections.map((s, i) => (
      <section id={s.id} class={`fs rv ${i % 2 ? 'r' : ''}`}>
        <div class="txt"><div class="kicker">{s.kicker}</div><h2>{s.title}</h2><p>{s.text}</p><ul>{s.points.map(p => <li>{p}</li>)}</ul></div>
        {s.img && <div class="img"><img src={`${img}/${s.img}.webp`} width="1920" height="1200" alt="" loading="lazy"></div>}
      </section>))}
    <section class="more"><h2>{f.more.h}</h2>
      <div class="grid">{f.more.items.map(([e, b, t]) => <div class="rv"><div class="e">{e}</div><b>{b}</b><span>{t}</span></div>)}</div>
    </section>
  </main>
</Base>

<style>
.fh{padding:64px 0 28px;text-align:center;background:radial-gradient(900px 360px at 50% -80px,#dcebff,transparent 70%)}
h1{font-size:clamp(36px,5vw,52px);margin:0 0 12px;letter-spacing:-.4px}
.lead{font-size:19px;color:var(--sub);max-width:680px;margin:0 auto 26px}
.toc{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:900px;margin:0 auto}
.toc a{font-size:14px;padding:6px 14px;border-radius:999px;background:var(--ice);color:var(--blue);font-weight:600}
.toc a:hover{background:#d6e7fd}
.fs{display:grid;grid-template-columns:1fr 1.3fr;gap:56px;align-items:center;padding:64px 0;border-bottom:1px solid var(--line)}
.fs.r{grid-template-columns:1.3fr 1fr}.fs.r .txt{order:2}
.kicker{font-size:14px;font-weight:700;color:var(--blue)}
.fs h2{font-size:clamp(26px,3vw,32px);line-height:1.25;margin:8px 0 12px}
.fs p{color:var(--sub);font-size:17px;margin:0 0 14px}
.fs ul{margin:0;padding:0;list-style:none;font-size:15px}.fs li{padding:5px 0 5px 26px;position:relative}
.fs li:before{content:"";position:absolute;left:0;top:11px;width:14px;height:14px;border-radius:50%;background:var(--ice);box-shadow:inset 0 0 0 4px var(--blue)}
.img{border-radius:16px;overflow:hidden;box-shadow:0 24px 60px rgba(15,23,42,.14),0 0 0 1px rgba(15,23,42,.06)}.img img{display:block;width:100%}
.more{padding:64px 0 20px}.more h2{font-size:30px;margin:0 0 24px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.grid>div{border:1px solid var(--line);border-radius:16px;padding:20px;transition:transform .2s,box-shadow .2s,border-color .2s}.grid>div:hover{transform:translateY(-3px);box-shadow:0 10px 26px rgba(15,23,42,.08);border-color:#d6e4f7}.grid .e{font-size:26px}.grid b{display:block;margin:8px 0 4px}.grid span{font-size:14px;color:var(--sub)}
@media (max-width:900px){.fs,.fs.r{grid-template-columns:1fr;gap:24px;padding:44px 0}.fs.r .txt{order:0}.grid{grid-template-columns:1fr 1fr}}
@media (max-width:560px){.grid{grid-template-columns:1fr}}
</style>

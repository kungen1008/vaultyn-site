---
// 所有页面共用：<head>、顶部导航、页脚、全站样式
import { T, LANGS, HTML_LANG, LANG_LABEL, path, type Lang } from '../i18n';
interface Props { lang: Lang; page?: string; title?: string; desc?: string }
const { lang, page = '', title, desc } = Astro.props;
const t = T[lang];
const pageTitle = title ? `${title} · Vaultyn` : t.meta.title;
const pageDesc = desc || t.meta.desc;
const site = 'https://vaultyn.com';
const pageUrl = site + path(lang, page);
const shareImage = site + `/share/${lang}.png`;
const schema = !page ? {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Vaultyn',
  applicationCategory: 'UtilitiesApplication', operatingSystem: 'macOS 12 or later',
  description: pageDesc, url: pageUrl,
  featureList: ['Local AES-256-GCM encryption', 'Argon2id key derivation', 'Two-factor codes', 'Encrypted attachments', 'Automatic backups'],
} : null;
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <meta name="theme-color" content="#0b1220">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script is:inline>document.documentElement.classList.add('js')</script>
  <link rel="canonical" href={pageUrl}>
  {LANGS.map(l => <link rel="alternate" hreflang={HTML_LANG[l]} href={site + path(l, page)}>)}
  <link rel="alternate" hreflang="x-default" href={site + path('en', page)}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={pageUrl}>
  <meta property="og:image" content={shareImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:site_name" content="Vaultyn">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={pageDesc}>
  <meta name="twitter:image" content={shareImage}>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
  <nav class="top"><div class="wrap">
    <a class="brand" href={path(lang)}><span class="ic"><img src="/favicon.svg" alt="" width="34" height="34"></span>Vaultyn</a>
    <button class="menu" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-links">☰</button>
    <div class="links" id="site-links">
      <a href={path(lang, 'features/')}>{t.nav.features}</a><a href={path(lang, 'security/')}>{t.nav.security}</a>
      <a href={path(lang, 'pricing/')}>{t.nav.pricing}</a><a href={path(lang, 'help/')}>{t.nav.help}</a>
    </div>
    <div class="right">
      <span class="lang">{LANGS.map((l, i) => <>{i > 0 && ' · '}{l === lang ? <b>{LANG_LABEL[l]}</b> : <a href={path(l, page)} hreflang={HTML_LANG[l]}>{LANG_LABEL[l]}</a>}</>)}</span>
      <a class="btn p sm" href={path(lang, 'pricing/')}>{t.nav.get}</a>
    </div>
  </div></nav>
  <slot />
  <footer><div class="wrap">
    <div><div class="brand small"><img src="/favicon.svg" alt="" width="24" height="24">Vaultyn</div><div class="muted">{t.footer.tagline}<br>© 2026 Vaultyn</div></div>
    <div class="cols">
      <div><b>{t.footer.product}</b><a href={path(lang, 'features/')}>{t.footer.links.features}</a><a href={path(lang, 'security/')}>{t.footer.links.security}</a><a href={path(lang, 'pricing/')}>{t.footer.links.pricing}</a></div>
      <div><b>{t.footer.support}</b><a href={path(lang, 'help/')}>{t.footer.links.help}</a><a href={path(lang, 'help/faq/')}>{t.footer.links.faq}</a><a href={path(lang, 'support/')}>{t.footer.links.contact}</a></div>
      <div><b>{t.footer.legal}</b><a href={path(lang, 'privacy/')}>{t.footer.links.privacy}</a><a href={path(lang, 'terms/')}>{t.footer.links.terms}</a><a href={path(lang, 'about/')}>{t.footer.links.about}</a></div>
    </div>
  </div></footer>
  <script is:inline>
    (() => { const b = document.querySelector('.menu'), n = document.querySelector('#site-links'); if (!b || !n) return; b.onclick = () => { const open = !n.classList.contains('open'); n.classList.toggle('open', open); b.setAttribute('aria-expanded', String(open)); }; })();
    // 滚动到附近时淡入（系统开了“减少动态效果”时直接显示）
    (() => {
      const els = document.querySelectorAll('.rv');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) { els.forEach(e => e.classList.add('in')); return; }
      const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      els.forEach(e => io.observe(e));
    })();
  </script>
</body>
</html>

<style is:global>
:root{--ink:#0b1220;--sub:#5b6476;--line:#e6e9f0;--blue:#007aff;--indigo:#4a55e0;--cyan:#bfefff;--ice:#eaf2fd;--bg:#fff;--soft:#f5f8fd}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;font:16px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei UI",sans-serif;color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
img{max-width:100%;height:auto}
.wrap{width:min(1120px,100% - 32px);margin:0 auto}
.muted{color:var(--sub);font-size:14px}
nav.top{position:sticky;top:0;background:rgba(255,255,255,.86);backdrop-filter:saturate(1.6) blur(12px);-webkit-backdrop-filter:saturate(1.6) blur(12px);border-bottom:1px solid var(--line);z-index:10}
nav.top .wrap{display:flex;align-items:center;height:64px;gap:28px}
.brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:20px;letter-spacing:.2px}
.brand .ic img{display:block;border-radius:9px}
.brand.small{font-size:17px;gap:8px;margin-bottom:8px}.brand.small img{border-radius:6px}
.links{display:flex;gap:26px;font-size:15px;color:var(--sub)}.links a:hover{color:var(--ink)}
.menu{display:none;border:0;background:transparent;color:var(--ink);font-size:22px;line-height:1;cursor:pointer}
.right{margin-left:auto;display:flex;align-items:center;gap:16px;font-size:14px;color:var(--sub)}
.lang b{color:var(--ink)}.lang a:hover{color:var(--ink)}
.btn{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:11px 22px;font-weight:600;font-size:15px;transition:transform .15s,box-shadow .15s}
.btn:hover{transform:translateY(-1px)}
.btn.p{background:var(--blue);color:#fff;box-shadow:0 6px 18px rgba(0,122,255,.28)}
.btn.d{background:#0b1220;color:#fff}
.btn.g{color:var(--blue)}
.btn.sm{padding:7px 16px;font-size:14px}
.btn.off{cursor:default}.btn.off:hover{transform:none}
footer{border-top:1px solid var(--line);padding:40px 0 60px;font-size:14px;color:var(--sub);margin-top:40px}
footer .wrap{display:flex;gap:40px;flex-wrap:wrap}
footer .cols{display:flex;gap:60px;margin-left:auto;flex-wrap:wrap}
footer .cols div{display:flex;flex-direction:column;gap:8px}footer .cols b{color:var(--ink)}footer a:hover{color:var(--ink)}
/* 滚动淡入（用动画而不是 transition，不影响卡片自己的悬停效果）；同一组里的元素依次出现 */
.js .rv{opacity:0}
.js .rv.in{animation:rvIn .7s cubic-bezier(.2,.7,.2,1) both}
.js .rv.in:nth-child(2){animation-delay:.06s}.js .rv.in:nth-child(3){animation-delay:.12s}.js .rv.in:nth-child(4){animation-delay:.18s}
@keyframes rvIn{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.js .rv{opacity:1}.js .rv.in{animation:none}}
@media (max-width:820px){
  .menu{display:block;margin-left:auto}.links{display:none;position:absolute;left:16px;right:16px;top:58px;flex-direction:column;gap:0;padding:8px;background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 14px 36px rgba(15,23,42,.14)}
  .links.open{display:flex}.links a{padding:10px 12px;border-radius:8px}.links a:hover{background:var(--soft)}
  nav.top .wrap{gap:12px}
  .right{margin-left:0}.lang{display:none}
  footer .cols{margin-left:0;gap:32px}
}
</style>
